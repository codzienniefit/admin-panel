{
	"name": "admin-panel",
	"description": "Codziennie Fit admin panel",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b && tsc -p e2e",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:ui": "playwright test",
		"test:ui:show": "playwright test --ui",
		"test:all": "npm run check && npm run test:ui",
		"secrets": "node scripts/check-secrets.mjs",
		"check": "npm run secrets && npm run typecheck && npm run lint && npm run test && npm run build",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@dnd-kit/core": "^6.3.1",
		"@tanstack/query-db-collection": "^1.5.1",
		"@tanstack/react-db": "^1.0.0-rc.1.4",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-router": "^1.170.46",
		"@tiptap/core": "^3.33.1",
		"@tiptap/extension-bold": "^3.33.1",
		"@tiptap/extension-document": "^3.33.1",
		"@tiptap/extension-hard-break": "^3.33.1",
		"@tiptap/extension-paragraph": "^3.33.1",
		"@tiptap/extension-text": "^3.33.1",
		"@tiptap/extensions": "^3.33.1",
		"@tiptap/pm": "^3.33.1",
		"@tiptap/react": "^3.33.1",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.91.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@biomejs/biome": "^2.6.6",
		"@cloudflare/vite-plugin": "^1.68.0",
		"@playwright/test": "^1.65.0",
		"@rolldown/plugin-babel": "^0.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/router-plugin": "^1.169.0",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0",
		"wrangler": "^4.160.0"
	}
