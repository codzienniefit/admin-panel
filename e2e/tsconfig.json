{
	"include": [".", "../playwright.config.ts"],
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"paths": { "@/*": ["../src/*"] },
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true
	}
}
